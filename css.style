body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #f4f6f9;
  color: #222;
}

header {
  background: #172554;
  color: white;
  text-align: center;
  padding: 30px 15px;
}

.products {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 20px;
  padding: 30px;
}

.product {
  background: white;
  padding: 25px;
  width: 220px;
  text-align: center;
  border-radius: 10px;
  box-shadow: 0 3px 12px #0001;
}

button {
  background: #2563eb;
  color: white;
  border: none;
  padding: 12px 18px;
  border-radius: 5px;
  cursor: pointer;
}
